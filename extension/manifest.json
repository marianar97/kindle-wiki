{
  "manifest_version": 3,
  "name": "Kindle Wiki Sync",
  "version": "0.1.0",
  "description": "Sync Kindle highlights from read.amazon.com/notebook into the Obsidian vault.",
  "action": {
    "default_title": "Kindle Wiki Sync"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": ["https://read.amazon.com/*"],
  "permissions": ["storage"]
}
